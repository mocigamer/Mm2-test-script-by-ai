local function removeVisual(p)
	local item = visuals[p]
	if item then
		item.highlight:Destroy()
		item.billboard:Destroy()
		visuals[p] = nil
	end
end

local function updateVisuals()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			local character, root = livingCharacter(p)
			local role, confirmed = getRole(p)
			local enabled = (role == "murder" and state.espMurder)
				or (role == "sheriff" and state.espSheriff)
				or ((role == "innocent" or role == "unknown") and state.espInnocent)

			if not enabled or not character then
				removeVisual(p)
			else
				local item = visuals[p]
				if item and item.character ~= character then
					removeVisual(p)
					item = nil
				end
				if not item then
					local highlight = instance("Highlight", {
						Adornee = character,
						DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
						FillTransparency = 0.72,
						OutlineTransparency = 0.12,
					}, worldFolder)

					local billboard = instance("BillboardGui", {
						Adornee = root,
						Size = UDim2.fromOffset(230, 45),
						StudsOffset = Vector3.new(0, 3.3, 0),
						AlwaysOnTop = true,
						MaxDistance = CONFIG.DistanciaMaxima,
					}, gui)
					local text = label(billboard, "", UDim2.new(), UDim2.fromScale(1, 1), 11)
					text.TextXAlignment = Enum.TextXAlignment.Center
					text.TextStrokeTransparency = 0.3
					text.TextStrokeColor3 = Color3.new(0, 0, 0)
					item = {
						character = character,
						highlight = highlight,
						billboard = billboard,
						text = text,
					}
					visuals[p] = item
				end

				local color, roleLabel
				if role == "murder" then
					color, roleLabel = colors.red, "MURDERER"
				elseif role == "sheriff" then
					color, roleLabel = colors.blue, "SHERIFF / GUN"
				elseif confirmed then
					color, roleLabel = colors.green, "INOCENTE"
				else
					color, roleLabel = colors.muted, "ROL NO CONFIRMADO"
				end
				item.highlight.FillColor = color
				item.highlight.OutlineColor = color
				item.text.TextColor3 = color
				item.text.Text = roleLabel .. "\n" .. p.DisplayName
			end
		end
	end
end

connect(Players.PlayerRemoving, function(p)
	removeVisual(p)
	roleCache[p.UserId] = nil
end)

connect(player.CharacterAdded, function()
	state.manualTarget = nil
	state.mouseOverride = nil
	message("Personaje actualizado. Los controles conservan su estado.")
end)

local bindName = "HanselMM2Aim_" .. tostring(player.UserId)
pcall(function() RunService:UnbindFromRenderStep(bindName) end)

RunService:BindToRenderStep(bindName, Enum.RenderPriority.Camera.Value + 1, function()
	if not state.alive then return end
	local tool, kind = equippedTool()
	local part = state.manualTarget

	if not livingCharacter(player) then
		part = nil
	elseif not part then
		if tool and ((kind == "gun" and state.aimGun)
			or (kind == "knife" and state.aimKnife)) then
			part = selectTarget(kind)
		end
	end

	if part and part.Parent and visible(part) then
		state.mouseOverride = part
		aimAt(part)
	else
		state.mouseOverride = nil
	end
end)

local baseDestroy = controller.Destroy
controller.Destroy = function()
	pcall(function() RunService:UnbindFromRenderStep(bindName) end)
	baseDestroy()
end
-- El botón conserva una función que también retira el render binding.
connect(gui.Destroying, function()
	if state.alive then controller.Destroy() end
end)

local elapsedVisual, elapsedRoles, elapsedLayout = 0, CONFIG.IntervaloRoles, 1
local lastViewport = Vector2.zero

connect(RunService.Heartbeat, function(dt)
	if not state.alive then return end
	elapsedVisual += dt
	elapsedRoles += dt
	elapsedLayout += dt

	if elapsedRoles >= CONFIG.IntervaloRoles then
		elapsedRoles = 0
		refreshRoles()
	end

	if elapsedVisual >= CONFIG.IntervaloVisual then
		elapsedVisual = 0
		updateVisuals()
		if os.clock() >= statusUntil then
			local source = os.clock() - roleTime < CONFIG.IntervaloRoles * 3
				and next(roleCache) ~= nil
				and "Roles replicados"
				or "Detección por armas; roles ocultos no confirmados"
			local mode = shared.mouseHook and "Mouse + cámara" or "Solo cámara"
			statusText = source .. "  •  " .. mode
				.. "\nAim requiere el arma equipada. El disparo depende del arma y del servidor."
		end
		footer.Text = statusText
		shootButton.BackgroundColor3 = state.busy
			and Color3.fromRGB(85, 30, 43)
			or Color3.fromRGB(38, 18, 25)
	end

	if elapsedLayout >= 0.5 then
		elapsedLayout = 0
		local size = viewport()
		if size ~= lastViewport then
			lastViewport = size
			scale.Scale = math.min(1, math.max(0.35,
				math.min((size.X - 24) / 530, (size.Y - 24) / 404)))
			task.defer(function()
				if not state.alive then return end
				clampObject(window)
				clampObject(reopen)
				clampObject(shootButton)
			end)
		end
	end
end)

-- Corrige el cierre para desconectar también el callback de cámara.
connect(close.Activated, function()
	pcall(function() RunService:UnbindFromRenderStep(bindName) end)
end)
