local function viewport()
	local camera = Workspace.CurrentCamera
	return camera and camera.ViewportSize or Vector2.new(800, 600)
end

local function clampObject(object)
	local size = viewport()
	local position, dimensions = object.AbsolutePosition, object.AbsoluteSize
	object.Position = UDim2.fromOffset(
		math.clamp(position.X, 4, math.max(4, size.X - dimensions.X - 4)),
		math.clamp(position.Y, 4, math.max(4, size.Y - dimensions.Y - 4))
	)
end

local function draggable(handle, object, onClick)
	local activeInput, startPointer, startPosition
	local moved = false
	local lastDrag = -math.huge

	connect(handle.InputBegan, function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		if activeInput then return end
		activeInput = input
		startPointer = Vector2.new(input.Position.X, input.Position.Y)
		startPosition = object.AbsolutePosition
		moved = false
	end)

	connect(UserInputService.InputChanged, function(input)
		if not activeInput then return end
		local touch = activeInput.UserInputType == Enum.UserInputType.Touch
		if (touch and input ~= activeInput)
			or (not touch and input.UserInputType ~= Enum.UserInputType.MouseMovement) then return end
		local delta = Vector2.new(input.Position.X, input.Position.Y) - startPointer
		if delta.Magnitude > 7 then moved = true end
		if moved then
			local position = startPosition + delta
			local dimensions = object.AbsoluteSize
			local view = viewport()
			object.Position = UDim2.fromOffset(
				math.clamp(position.X, 4, math.max(4, view.X - dimensions.X - 4)),
				math.clamp(position.Y, 4, math.max(4, view.Y - dimensions.Y - 4))
			)
		end
	end)

	connect(UserInputService.InputEnded, function(input)
		if input == activeInput then
			if moved then lastDrag = os.clock() end
			activeInput = nil
		end
	end)

	if onClick then
		connect(handle.Activated, function()
			if not moved and os.clock() - lastDrag > 0.2 then onClick() end
		end)
	end
end

