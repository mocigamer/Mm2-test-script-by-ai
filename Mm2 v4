local function connect(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(connections, connection)
	return connection
end

local function spawnManaged(callback)
	local thread
	thread = coroutine.create(function()
		local ok, err = xpcall(callback, debug.traceback)
		tasks[coroutine.running()] = nil
		if not ok and state.alive then
			warn("[Hansel MM2] " .. tostring(err))
			state.busy = false
			state.manualTarget = nil
			state.mouseOverride = nil
		end
	end)
	tasks[thread] = true
	task.spawn(thread)
	return thread
end

local function message(text, seconds)
	if not state.alive then return end
	statusText = text
	statusUntil = os.clock() + (seconds or 5)
	if footer then footer.Text = text end
end

local function releaseInput()
	local release = activeRelease
	activeRelease = nil
	if release then pcall(release) end
end

local function cancelAction()
	state.actionId += 1
	state.busy = false
	state.manualTarget = nil
	state.mouseOverride = nil
	releaseInput()
end

controller.Destroy = function()
	if destroyed then return end
	destroyed = true
	state.alive = false
	cancelAction()
	pcall(function() RunService:UnbindFromRenderStep(bindName) end)
	disconnectList(connections)
	table.clear(connections)
	for thread in pairs(tasks) do
		if thread ~= coroutine.running() then pcall(task.cancel, thread) end
	end
	table.clear(tasks)
	restoreSaved(savedProperties)
	table.clear(savedProperties)
	for _, item in pairs(visuals) do
		pcall(function() item.highlight:Destroy() end)
		pcall(function() item.billboard:Destroy() end)
	end
	table.clear(visuals)
	if worldFolder then worldFolder:Destroy() end
	if gui then gui:Destroy() end
	if shared.controller == controller then
		shared.controller = nil
		shared.alive = false
		shared.connections = nil
		shared.savedProperties = nil
	end
end

local function instance(className, properties, parent)
	local object = Instance.new(className)
	for name, value in pairs(properties) do object[name] = value end
	object.Parent = parent
	return object
end

