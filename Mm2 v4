local function livingCharacter(p)
	if not p or p.Parent ~= Players then return end
	local character = p.Character
	if not character or not character.Parent then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if humanoid and humanoid.Health > 0 and root and root:IsA("BasePart") then
		return character, root, humanoid
	end
end

local function toolKind(tool)
	if not tool or not tool:IsA("Tool") then return end
	local name = string.lower(tool.Name)
	if name == string.lower(CONFIG.NombreKnife) then return "knife" end
	if name == string.lower(CONFIG.NombreGun) then return "gun" end
end

local function equippedTool()
	local character = player.Character
	if not character then return end
	for _, object in ipairs(character:GetChildren()) do
		local kind = toolKind(object)
		if kind then return object, kind end
	end
end

local function observedWeapon(p)
	local hasGun = false
	for _, container in ipairs({
		p.Character or false,
		p:FindFirstChildOfClass("Backpack") or false,
	}) do
		if container then
			for _, object in ipairs(container:GetChildren()) do
				local kind = toolKind(object)
				if kind == "knife" then return "murder" end
				if kind == "gun" then hasGun = true end
			end
		end
	end
	if hasGun then return "sheriff" end
end

local function normalizeRole(role)
	if type(role) ~= "string" then return end
	role = string.lower(role)
	if role == "murderer" or role == "murder" then return "murder" end
	if role == "sheriff" or role == "hero" then return "sheriff" end
	if role == "innocent" then return "innocent" end
end

local function getRole(p)
	local observed = observedWeapon(p)
	if observed then return observed, true end
	if os.clock() - roleTime < CONFIG.IntervaloRoles * 3 then
		local role = roleCache[p.UserId]
		if role then return role, true end
	end
	return "unknown", false
end

local function refreshRoles()
	if fetching or not state.alive then return end
	if not rolesRemote or not rolesRemote:IsDescendantOf(ReplicatedStorage) then
		if os.clock() < nextRemoteSearch then return end
		nextRemoteSearch = os.clock() + 10
		rolesRemote = nil
		local candidate = ReplicatedStorage:FindFirstChild(CONFIG.NombreConsultaRoles, true)
		if candidate and candidate:IsA("RemoteFunction") then rolesRemote = candidate end
	end
	if not rolesRemote then return end

	fetching = true
	fetchStarted = os.clock()
	local remote = rolesRemote
	roleThread = spawnManaged(function()
		local ok, data = pcall(function() return remote:InvokeServer() end)
		fetching = false
		if not state.alive then return end
		if ok and type(data) == "table" then
			local cache = {}
			for _, p in ipairs(Players:GetPlayers()) do
				local entry = data[p.Name] or data[p.UserId] or data[tostring(p.UserId)]
				if type(entry) == "table" and entry.Dead ~= true and entry.Killed ~= true then
					cache[p.UserId] = normalizeRole(entry.Role)
				end
			end
			roleCache, roleTime = cache, os.clock()
		end
	end)
end

local function targetPart(p)
	local character = livingCharacter(p)
	if not character then return end
	local part = character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("Torso")
		or character:FindFirstChild("HumanoidRootPart")
	if part and part:IsA("BasePart") then return part end
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function clearRay(origin, part)
	if not part or not part.Parent then return false end
	local camera = Workspace.CurrentCamera
	local filter = {worldFolder}
	if player.Character then table.insert(filter, player.Character) end
	if camera then table.insert(filter, camera) end
	rayParams.FilterDescendantsInstances = filter
	local direction = part.Position - origin
	if direction.Magnitude > CONFIG.DistanciaMaxima then return false end
	local hit = Workspace:Raycast(origin, direction, rayParams)
	return not hit or hit.Instance:IsDescendantOf(part.Parent)
end

local function visible(part)
	local camera = Workspace.CurrentCamera
	local _, root = livingCharacter(player)
	if not camera or not root or not part or not part.Parent then return false end
	-- Comprueba también desde el personaje: la cámara puede mirar tras una pared.
	return clearRay(camera.CFrame.Position, part)
		and clearRay(root.Position + Vector3.new(0, 1, 0), part)
end

local function inKnifeRange(part)
	local _, root = livingCharacter(player)
	return root and part and part.Parent
		and (part.Position - root.Position).Magnitude <= CONFIG.AlcanceCuchillo
end

local function selectTarget(kind, requiredRole, closeOnly)
	local camera = Workspace.CurrentCamera
	if not camera or not livingCharacter(player) then return end
	local center = camera.ViewportSize / 2
	local bestPart, bestPlayer
	local bestScore = math.huge
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			local role = getRole(p)
			local eligible = requiredRole and role == requiredRole
				or (not requiredRole and (kind == "knife" or role == "murder"))
			if eligible then
				local part = targetPart(p)
				if part and visible(part) and (not closeOnly or inKnifeRange(part)) then
					local screen, onScreen = camera:WorldToViewportPoint(part.Position)
					local distance = (part.Position - camera.CFrame.Position).Magnitude
					local score = onScreen
						and ((Vector2.new(screen.X, screen.Y) - center).Magnitude + distance * 0.15)
						or (10000 + distance)
					if score < bestScore then
						bestScore, bestPart, bestPlayer = score, part, p
					end
				end
			end
		end
	end
	return bestPart, bestPlayer
end

-- Reutiliza el hook V3: consulta siempre shared.controller.
if CONFIG.UsarCompatibilidadMouse and not shared.mouseHook
	and type(hookmetamethod) == "function" then
	local previous
	local function indexHook(object, key)
		local current = shared.controller
		local s = current and current.state
		local part = s and s.alive and s.mouseOverride
		local internal = false
		if type(checkcaller) == "function" then internal = checkcaller() end
		if not internal and part and object == mouse
			and (key == "Hit" or key == "Target" or key == "UnitRay") then
			if part.Parent then
				if key == "Target" then return part end
				if key == "Hit" then return CFrame.new(part.Position) end
				local camera = Workspace.CurrentCamera
				if camera then
					local delta = part.Position - camera.CFrame.Position
					if delta.Magnitude > 0.001 then
						return Ray.new(camera.CFrame.Position, delta.Unit)
					end
				end
			end
		end
		return previous(object, key)
	end
	local ok = pcall(function()
		local callback = indexHook
		if type(newcclosure) == "function" then callback = newcclosure(callback) end
		previous = hookmetamethod(game, "__index", callback)
	end)
	if ok and type(previous) == "function" then shared.mouseHook = true end
end

local function aimAt(part)
	local camera = Workspace.CurrentCamera
	if not camera or not part or not part.Parent then return false end
	local origin = camera.CFrame.Position
	if (part.Position - origin).Magnitude < 0.01 then return false end
	camera.CFrame = CFrame.lookAt(origin, part.Position)
	return true
end

local function signalConnections(signal)
	if type(getconnections) ~= "function" then return nil end
	local ok, list = pcall(getconnections, signal)
	if not ok or type(list) ~= "table" then return nil end
	local usable = {}
	for _, connection in ipairs(list) do
		local readable, enabled, fire = pcall(function()
			return connection.Enabled, connection.Fire
		end)
		if readable and enabled ~= false and type(fire) == "function" then
			table.insert(usable, connection)
		end
	end
	return usable
end

local function emitMouse(signal)
	local list = signalConnections(signal)
	if list and #list == 0 then return false end
	if type(firesignal) == "function" then
		local ok = pcall(firesignal, signal)
		if ok then return true end
	end
	if list then
		local fired = false
		for _, connection in ipairs(list) do
			local ok = pcall(function() connection:Fire() end)
			fired = fired or ok
		end
		return fired
	end
	return false
end

local function pressWeapon(tool)
	if not tool or tool.Parent ~= player.Character or not tool.Enabled then
		return false, "El arma no está equipada o está en enfriamiento."
	end

	local method = CONFIG.MetodoEntrada
	local listeners = signalConnections(mouse.Button1Down)
	local mouseAvailable = type(firesignal) == "function"
		or (listeners and #listeners > 0)

	-- Corrección principal: algunas armas escuchan Mouse.Button1Down,
	-- no Tool.Activated. Se usa una sola vía para no duplicar ataques.
	local useMouse = method == "Mouse"
		or (method == "Auto" and shared.mouseHook and mouseAvailable
			and (not listeners or #listeners > 0))

	if useMouse and emitMouse(mouse.Button1Down) then
		activeRelease = function() emitMouse(mouse.Button1Up) end
		return true, "Mouse.Button1Down"
	end

	local ok, err = pcall(function() tool:Activate() end)
	if ok then
		activeRelease = function()
			if tool.Parent then tool:Deactivate() end
		end
		return true, "Tool:Activate"
	end
	return false, tostring(err)
end

local function actionValid(id, key, tool, kind, target, part, closeOnly)
	if not state.alive or state.actionId ~= id or not state[key] then return false end
	if not livingCharacter(player) then return false end
	local current, currentKind = equippedTool()
	return current == tool and currentKind == kind and tool.Enabled
		and targetPart(target) == part and visible(part)
		and (not closeOnly or inKnifeRange(part))
end

local function requestAttack(id, key, tool, kind, target, part, closeOnly)
	if not actionValid(id, key, tool, kind, target, part, closeOnly) then
		return false, "Objetivo fuera de alcance, oculto o arma no disponible."
	end
	state.manualTarget, state.mouseOverride = part, part
	aimAt(part)
	task.wait(0.08)
	if not actionValid(id, key, tool, kind, target, part, closeOnly) then
		return false, "Ataque cancelado: cambió el arma o se perdió el objetivo."
	end
	aimAt(part)
	local ok, method = pressWeapon(tool)
	task.wait(0.12)
	if state.actionId == id then
		releaseInput()
		state.manualTarget, state.mouseOverride = nil, nil
	end
	return ok, method
end

local function beginAction(key, requiredKind)
	if not state[key] or state.busy then return end
	if not livingCharacter(player) then
		message("Tu personaje no está activo.")
		return
	end
	local tool, kind = equippedTool()
	if kind ~= requiredKind then
		message(requiredKind == "gun"
			and "Equipa la Gun del sheriff o del héroe."
			or "Equipa tu Knife. Esta acción requiere el arma del murderer.")
		return
	end
	if not tool.Enabled then
		message("El arma está en enfriamiento.")
		return
	end
	state.actionId += 1
	state.busy = true
	return state.actionId, tool
end

local function finishAction(id)
	if state.actionId ~= id then return end
	releaseInput()
	state.manualTarget, state.mouseOverride = nil, nil
	state.busy = false
end

local function shootMurderer()
	local id, tool = beginAction("autoShoot", "gun")
	if not id then return end
	local part, target = selectTarget("gun", "murder", false)
	if not part then
		finishAction(id)
		message("No hay un murderer confirmado con línea de visión.")
		return
	end
	spawnManaged(function()
		local ok, detail = requestAttack(id, "autoShoot", tool, "gun", target, part, false)
		if state.actionId == id then
			message(ok
				and ("Entrada enviada: " .. detail .. " → " .. target.DisplayName
					.. ". No confirma un disparo ni un impacto.")
				or detail)
			finishAction(id)
		end
	end)
end

local function attackSheriff()
	local id, tool = beginAction("killSheriff", "knife")
	if not id then return end
	local part, target = selectTarget("knife", "sheriff", true)
	if not part then
		finishAction(id)
		message("Acércate al sheriff: necesita estar visible y a "
			.. CONFIG.AlcanceCuchillo .. " studs o menos.")
		return
	end
	spawnManaged(function()
		local ok, detail = requestAttack(id, "killSheriff", tool, "knife", target, part, true)
		if state.actionId == id then
			message(ok
				and ("Ataque solicitado contra " .. target.DisplayName .. " mediante " .. detail .. ".")
				or detail)
			finishAction(id)
		end
	end)
end

local function attackAll()
	local id, tool = beginAction("killAll", "knife")
	if not id then return end
	spawnManaged(function()
		local _, root = livingCharacter(player)
		if not root then finishAction(id) return end
		local targets = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player then
				local part = targetPart(p)
				if part and visible(part) and inKnifeRange(part) then
					table.insert(targets, {
						player = p,
						part = part,
						distance = (part.Position - root.Position).Magnitude,
					})
				end
			end
		end
		table.sort(targets, function(a, b) return a.distance < b.distance end)
		local sent = 0
		for _, entry in ipairs(targets) do
			if state.actionId ~= id or not state.alive or not state.killAll then break end
			local ok = requestAttack(id, "killAll", tool, "knife",
				entry.player, entry.part, true)
			if ok then sent += 1 end
			task.wait(CONFIG.PausaCuchillo)
		end
		if state.actionId == id then
			message(sent > 0
				and ("Barrido terminado: " .. sent .. " entradas de ataque enviadas; no son bajas confirmadas.")
				or "No hay objetivos visibles al alcance. Acércate con Knife equipada.")
			finishAction(id)
		end
	end)
end

