local function disconnectList(list)
	if type(list) ~= "table" then return end
	for _, item in pairs(list) do
		if typeof(item) == "RBXScriptConnection" then
			pcall(function() item:Disconnect() end)
		end
	end
end

local function restoreSaved(list)
	-- Formato empleado por este controlador: {instance, property, value}.
	if type(list) ~= "table" then return end
	for _, item in pairs(list) do
		if type(item) == "table" and typeof(item.instance) == "Instance"
			and type(item.property) == "string" then
			pcall(function()
				if item.instance.Parent then
					item.instance[item.property] = item.value
				end
			end)
		end
	end
end

local old = shared.controller
if type(old) == "table" then
	-- Primero ejecuta su cierre: V3 necesita alive=true para limpiar sus recursos.
	if type(old.Destroy) == "function" then
		pcall(function() old.Destroy() end)
	end
	if type(old.state) == "table" then
		old.state.alive = false
		old.state.running = false
		old.state.mouseOverride = nil
		old.state.manualTarget = nil
	end
	disconnectList(old.connections)
	restoreSaved(old.savedProperties)
end
