local function removeVisual(p)
	local item = visuals[p]
	if not item then return end
	item.highlight:Destroy()
	item.billboard:Destroy()
	visuals[p] = nil
end

local function updateVisuals()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			local character, root = livingCharacter(p)
			local role, confirmed = getRole(p)
			local enabled = (role == "murder" and state.espMurder)
				or (role == "sheriff" and state.espSheriff)
				or ((role == "innocent" or role == "unknown") and state.espInnocent)
			if not enabled or not character then
				removeVisual(p)
			else
				local item = visuals[p]
				if item and item.character ~= character then
					removeVisual(p)
					item = nil
				end
				if not item then
					local highlight = instance("Highlight", {
						Adornee = character,
						DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
						FillTransparency = 0.72,
						OutlineTransparency = 0.12,
					}, worldFolder)
					local billboard = instance("BillboardGui", {
						Adornee = root,
						Size = UDim2.fromOffset(230, 45),
						StudsOffset = Vector3.new(0, 3.3, 0),
						AlwaysOnTop = true,
						MaxDistance = CONFIG.DistanciaMaxima,
					}, gui)
					local text = label(billboard, "", UDim2.new(), UDim2.fromScale(1, 1), 11)
					text.TextXAlignment = Enum.TextXAlignment.Center
					text.TextStrokeTransparency = 0.3
					text.TextStrokeColor3 = Color3.new(0, 0, 0)
					item = {
						character = character,
						highlight = highlight,
						billboard = billboard,
						text = text,
					}
					visuals[p] = item
				end
				local color, roleLabel
				if role == "murder" then
					color, roleLabel = colors.red, "MURDERER"
				elseif role == "sheriff" then
					color, roleLabel = colors.blue, "SHERIFF / GUN"
				elseif confirmed then
					color, roleLabel = colors.green, "INOCENTE"
				else
					color, roleLabel = colors.muted, "ROL NO CONFIRMADO"
				end
				item.billboard.Adornee = root
				item.highlight.FillColor = color
				item.highlight.OutlineColor = color
				item.text.TextColor3 = color
				item.text.Text = roleLabel .. "\n" .. p.DisplayName
			end
		end
	end
end

