RunService:BindToRenderStep(bindName, Enum.RenderPriority.Camera.Value + 1, function()
	if not state.alive then return end
	local tool, kind = equippedTool()
	local part = state.manualTarget
	if not livingCharacter(player) then
		part = nil
	elseif not part and not state.busy then
		if tool and ((kind == "gun" and state.aimGun)
			or (kind == "knife" and state.aimKnife)) then
			part = selectTarget(kind)
		end
	end
	if part and part.Parent and visible(part) then
		state.mouseOverride = CONFIG.UsarCompatibilidadMouse and part or nil
		aimAt(part)
	else
		state.mouseOverride = nil
	end
end)

local elapsedVisual, elapsedRoles, elapsedLayout = 0, CONFIG.IntervaloRoles, 1
local lastViewport = Vector2.zero
local floatingButtons = {reopen, shootButton, sheriffButton, allButton}

connect(RunService.Heartbeat, function(dt)
	if not state.alive then return end
	elapsedVisual += dt
	elapsedRoles += dt
	elapsedLayout += dt

	if fetching and os.clock() - fetchStarted >= CONFIG.TimeoutRoles then
		if roleThread then
			pcall(task.cancel, roleThread)
			tasks[roleThread] = nil
		end
		roleThread = nil
		fetching = false
		rolesRemote = nil
		nextRemoteSearch = os.clock() + 15
	end

	if elapsedRoles >= CONFIG.IntervaloRoles then
		elapsedRoles = 0
		refreshRoles()
	end

	if elapsedVisual >= CONFIG.IntervaloVisual then
		elapsedVisual = 0
		updateVisuals()
		updateKnifeIcons()

		if os.clock() >= statusUntil then
			local source = os.clock() - roleTime < CONFIG.IntervaloRoles * 3
				and next(roleCache) ~= nil and "Roles replicados"
				or "Roles por armas; los demás no están confirmados"
			local mode = shared.mouseHook and CONFIG.UsarCompatibilidadMouse
				and "Mouse + cámara" or "Solo cámara"
			statusText = source .. " · " .. mode
				.. "\nAtaques sujetos al arma, distancia y servidor. RightShift: mostrar/ocultar."
		end
		footer.Text = statusText
		for _, button in ipairs({shootButton, sheriffButton, allButton}) do
			button.BackgroundColor3 = state.busy
				and Color3.fromRGB(48, 34, 59) or colors.panel
		end
	end

	if elapsedLayout >= 0.5 then
		elapsedLayout = 0
		local size = viewport()
		if size ~= lastViewport then
			lastViewport = size
			scale.Scale = math.min(1, math.max(0.35,
				math.min((size.X - 24) / 530, (size.Y - 24) / 428)))
			spawnManaged(function()
				task.wait()
				if not state.alive then return end
				setClampedPosition(window, window.AbsolutePosition)
				for _, button in ipairs(floatingButtons) do
					setClampedPosition(button, button.AbsolutePosition)
				end
			end)
		end
	end
end)

