shootButton.TextSize = 24
shootButton.Visible = false
shootButton.Active = true
shootButton.Draggable = true
shootButton.Parent = ScreenGui

shootButton.MouseButton1Click:Connect(function()
    if not Settings.AutoShootMurder then return end
    local murderer = getMurderer()
    if murderer and murderer.Character and murderer.Character:FindFirstChild("HumanoidRootPart") then
        local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Gun")
        if tool then
            local args = {
                [1] = 1,
                [2] = murderer.Character.HumanoidRootPart.Position,
                [3] = "AH"
            }
            tool.Shoot:FireServer(unpack(args))
        end
    end
end)

RunService.RenderStepped:Connect(function()
    shootButton.Visible = Settings.AutoShootMurder

    if Settings.HitboxSize > 2 then
        local murderer = getMurderer()
        if murderer and murderer.Character then
            local hrp = murderer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.Size = Vector3.new(Settings.HitboxSize, Settings.HitboxSize, Settings.HitboxSize)
                hrp.Transparency = 0.7
                hrp.CanCollide = false
            end
        end
    end

    if Settings.AutoPickGun then
        for _, obj in ipairs(workspace:GetChildren()) do
            if obj.Name == "GunDrop" and obj:IsA("BasePart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local dist = (LocalPlayer.Character.HumanoidRootPart.Position - obj.Position).Magnitude
                if dist < 15 then
                    firetouchinterest(LocalPlayer.Character.HumanoidRootPart, obj, 0)
                    firetouchinterest(LocalPlayer.Character.HumanoidRootPart, obj, 1)
                end
            end
        end
    end

    if Settings.AimbotGun then
        local murderer = getMurderer()
        if murderer and murderer.Character and murderer.Character:FindFirstChild("HumanoidRootPart") then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, murderer.Character.HumanoidRootPart.Position)
        end
    end

    if Settings.AimbotKnife then
        local murderer = getMurderer()
        if murderer and murderer.Character and murderer.Character:FindFirstChild("HumanoidRootPart") then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, murderer.Character.HumanoidRootPart.Position)
        end
    end

    if Settings.KillSheriff then
        local sheriff = getSheriff()
        local knife = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Knife")
        if sheriff and sheriff.Character and sheriff.Character:FindFirstChild("HumanoidRootPart") and knife then
            LocalPlayer.Character.HumanoidRootPart.CFrame = sheriff.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 2)
            knife:Activate()
        end
    end

    if Settings.KillAll then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local knife = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Knife")
                if knife then
                    LocalPlayer.Character.HumanoidRootPart.CFrame = player.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 2)
                    knife:Activate()
                end
            end
        end
    end
end)
