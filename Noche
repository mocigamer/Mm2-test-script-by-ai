    HitboxSize = 2
}

local function getRole(player)
    local character = player.Character
    if not character then return "Innocent" end
    
    if character:FindFirstChild("Gun") or player.Backpack:FindFirstChild("Gun") then
        if player == LocalPlayer and player.Character:FindFirstChild("Gun") and player.Character.Gun.Enabled then
            return "Sheriff"
        elseif not (character:FindFirstChild("Knife") or player.Backpack:FindFirstChild("Knife")) then
            return "Sheriff"
        end
    end
    if character:FindFirstChild("Knife") or player.Backpack:FindFirstChild("Knife") then
        return "Murderer"
    end
    return "Innocent"
end

local function getMurderer()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and (char:FindFirstChild("Knife") or player.Backpack:FindFirstChild("Knife")) then
                return player
            end
        end
    end
    return nil
end

local function getSheriff()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and (char:FindFirstChild("Gun") or player.Backpack:FindFirstChild("Gun")) then
                return player
            end
        end
    end
    return nil
end

local shootButton = Instance.new("TextButton")
shootButton.Size = UDim2.new(0, 50, 0, 50)
shootButton.Position = UDim2.new(0.8, 0, 0.8, 0)
