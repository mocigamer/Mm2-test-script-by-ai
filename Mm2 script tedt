local function create(class, properties, parent)
	local object = Instance.new(class)
	for key, value in pairs(properties or {}) do object[key] = value end
	object.Parent = parent
	return object
end

local function connect(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(connections, connection)
	return connection
end

local function corner(object, radius)
	create("UICorner", { CornerRadius = UDim.new(0, radius or 12) }, object)
end

local function label(parent, text, position, size, fontSize, color)
	return create("TextLabel", {
		BackgroundTransparency = 1,
		Position = position,
		Size = size,
		Text = text,
		TextColor3 = color or C.Text,
		TextSize = fontSize or 14,
		Font = Enum.Font.Gotham,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
	}, parent)
end

local function button(parent, text, position, size)
	local result = create("TextButton", {
		Position = position,
		Size = size,
		BackgroundColor3 = C.Card,
		BorderSizePixel = 0,
		Text = text,
		TextColor3 = C.Text,
		TextSize = 14,
		Font = Enum.Font.GothamMedium,
		AutoButtonColor = false,
	}, parent)
	corner(result, 10)
	return result
end

