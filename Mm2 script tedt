-- Arrastre táctil y con ratón.
local dragInput, dragStart, dragPosition
connect(top.InputBegan, function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		local rightEdge = top.AbsolutePosition.X + top.AbsoluteSize.X - 104 * scale.Scale
		if input.Position.X >= rightEdge then return end
		dragInput = input
		dragStart = Vector2.new(input.Position.X, input.Position.Y)
		dragPosition = window.Position
	end
end)
connect(UIS.InputChanged, function(input)
	if not dragInput then return end
	local touch = dragInput.UserInputType == Enum.UserInputType.Touch
	if (touch and input ~= dragInput)
		or (not touch and input.UserInputType ~= Enum.UserInputType.MouseMovement) then return end
	local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStart
	local camera = Workspace.CurrentCamera
	if not camera then return end
	local viewport = camera.ViewportSize
	local x = dragPosition.X.Scale * viewport.X + dragPosition.X.Offset + delta.X
	local y = dragPosition.Y.Scale * viewport.Y + dragPosition.Y.Offset + delta.Y
	x = math.clamp(x, 50, math.max(50, viewport.X - 50))
	y = math.clamp(y, 35, math.max(35, viewport.Y - 35))
	window.Position = UDim2.fromOffset(x, y)
end)
connect(UIS.InputEnded, function(input)
	if input == dragInput then dragInput = nil end
end)

local murderNames, sheriffNames = {}, {}
for _, name in ipairs(CONFIG.HerramientasMurder) do murderNames[string.lower(name)] = true end
for _, name in ipairs(CONFIG.HerramientasSheriff) do sheriffNames[string.lower(name)] = true end

local function weaponRole(container)
	if not container then return nil end
	local gun = false
	for _, object in ipairs(container:GetChildren()) do
		if object:IsA("Tool") then
			local name = string.lower(object.Name)
			if murderNames[name] then return "Murder" end
			if sheriffNames[name] then gun = true end
		end
	end
	return gun and "Sheriff" or nil
end

local function livingCharacter(p)
	local character = p.Character
	if not character or not character:IsDescendantOf(Workspace) then return nil end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
		return nil
	end
	return character, root
end

local function removeEffect(p)
	local effect = effects[p]
	if not effect then return end
	effect.Highlight:Destroy()
	effect.Billboard:Destroy()
	effects[p] = nil
end

local roleLabels = {
	Murder = "MURDER",
	Sheriff = "SHERIFF / GUN",
	Innocent = "INOCENTE?",
}

refreshVisuals = function()
	if not alive then return end
	local newRecords, seen = {}, {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			local character, root = livingCharacter(p)
			if character then
				local equipped = weaponRole(character)
				local backpack = weaponRole(p:FindFirstChildOfClass("Backpack"))
				local role = (equipped == "Murder" or backpack == "Murder") and "Murder"
					or equipped or backpack or "Innocent"
				newRecords[p] = { Character = character, Root = root, Role = role }
				if state[role] then
					seen[p] = true
					local effect = effects[p]
					if effect and effect.Character ~= character then
						removeEffect(p)
						effect = nil
					end
					if not effect then
						local highlight = create("Highlight", {
							Adornee = character,
							DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
							FillTransparency = 0.73,
							OutlineTransparency = 0.05,
						}, visualFolder)
						local billboard = create("BillboardGui", {
							Adornee = root,
							Size = UDim2.fromOffset(190, 44),
							StudsOffsetWorldSpace = Vector3.new(0, 3.3, 0),
							AlwaysOnTop = true,
							MaxDistance = 1500,
						}, visualFolder)
						local text = label(billboard, "", UDim2.new(), UDim2.fromScale(1, 1), 12)
						text.Font = Enum.Font.GothamBold
						text.TextXAlignment = Enum.TextXAlignment.Center
						text.TextStrokeTransparency = 0.25
						effect = {
							Character = character,
							Highlight = highlight,
							Billboard = billboard,
							Text = text,
						}
						effects[p] = effect
					end
					effect.Highlight.FillColor = C[role]
					effect.Highlight.OutlineColor = C[role]
					effect.Text.TextColor3 = C[role]
					effect.Text.Text = roleLabels[role] .. "\n" .. p.DisplayName
				end
			end
		end
	end
	records = newRecords
	local obsolete = {}
	for p in pairs(effects) do
		if not seen[p] then table.insert(obsolete, p) end
	end
	for _, p in ipairs(obsolete) do removeEffect(p) end
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function chooseTarget(camera, mode, ownCharacter)
	local viewport = camera.ViewportSize
	local center = viewport * 0.5
	local bestDistance = math.min(CONFIG.RadioAim, math.min(viewport.X, viewport.Y) * 0.46)
	local bestPlayer, bestPosition
	rayParams.FilterDescendantsInstances = { ownCharacter, camera }

	for p, record in pairs(records) do
		local character = record.Character
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if p.Parent == Players and p.Character == character
			and character:IsDescendantOf(Workspace)
			and humanoid and humanoid.Health > 0
			and (mode == "Knife" or record.Role == "Murder") then

			local part = character:FindFirstChild("Head") or record.Root
			if part and part:IsA("BasePart") then
				local prediction = mode == "Gun" and CONFIG.PrediccionGun or CONFIG.PrediccionKnife
				local position = part.Position + record.Root.AssemblyLinearVelocity * prediction
				local projected, onScreen = camera:WorldToViewportPoint(position)
				if onScreen and projected.Z > 0 then
					local distance = (Vector2.new(projected.X, projected.Y) - center).Magnitude
					if distance < bestDistance then
						local visible = true
						if CONFIG.ComprobarParedes then
							local origin = camera.CFrame.Position
							local hit = Workspace:Raycast(origin, part.Position - origin, rayParams)
							visible = not hit or hit.Instance:IsDescendantOf(character)
						end
						if visible then
							bestDistance = distance
							bestPlayer, bestPosition = p, position
						end
					end
				end
			end
		end
	end
	return bestPlayer, bestPosition
end

local elapsed, statusElapsed = CONFIG.IntervaloESP, 0
local bindName = "HanselMM2Aim_" .. tostring(player.UserId)

local function destroy()
	if not alive then return end
	alive = false
	RunService:UnbindFromRenderStep(bindName)
	for _, connection in ipairs(connections) do connection:Disconnect() end
	table.clear(connections)
	local list = {}
	for p in pairs(effects) do table.insert(list, p) end
	for _, p in ipairs(list) do removeEffect(p) end
	table.clear(records)
	if gui.Parent then gui:Destroy() end
	if ENV[KEY] == runtime then ENV[KEY] = nil end
end

runtime.Destroy = destroy
connect(shutdown.Event, destroy)
connect(close.Activated, destroy)
connect(gui.Destroying, destroy)
connect(Players.PlayerRemoving, function(p)
	removeEffect(p)
	records[p] = nil
end)

connect(RunService.Heartbeat, function(dt)
	elapsed += dt
	if elapsed >= CONFIG.IntervaloESP then
		elapsed = 0
		refreshVisuals()
	end
end)

RunService:UnbindFromRenderStep(bindName)
RunService:BindToRenderStep(bindName, Enum.RenderPriority.Camera.Value + 1, function(dt)
	if not alive then return end
	local camera = Workspace.CurrentCamera
	if not camera then return end

	local viewport = camera.ViewportSize
	scale.Scale = math.min(1, math.max(0.25,
		math.min((viewport.X - 20) / 454, (viewport.Y - 28) / 420)))

	local ownCharacter = livingCharacter(player)
	local mode, target, targetPosition
	local status = "Aim apagado · ESP basado en armas visibles."

	if state.Gun or state.Knife then
		status = "Equipa Gun o Knife · roles sin arma no confirmados."
		if ownCharacter then
			local equipped = weaponRole(ownCharacter)
			if state.Gun and equipped == "Sheriff" then
				mode = "Gun"
			elseif state.Knife and equipped == "Murder" then
				mode = "Knife"
			end
		else
			status = "Esperando personaje vivo…"
		end
	end

	if mode and ownCharacter then
		target, targetPosition = chooseTarget(camera, mode, ownCharacter)
		status = target and (mode .. " → " .. target.DisplayName .. " · ataque manual")
			or (mode .. " · sin objetivo visible dentro del radio")
		if targetPosition and not UIS:GetFocusedTextBox()
			and camera.CameraType ~= Enum.CameraType.Scriptable then
			local origin = camera.CFrame.Position
			if (targetPosition - origin).Magnitude > 0.01 then
				local alpha = 1 - math.exp(-CONFIG.Suavidad * math.min(dt, 0.1))
				camera.CFrame = camera.CFrame:Lerp(CFrame.lookAt(origin, targetPosition), alpha)
			end
		end
	end

	statusElapsed += dt
	if statusElapsed >= 0.15 then
		statusElapsed = 0
		footer.Text = status
	end
end)

refreshVisuals()
